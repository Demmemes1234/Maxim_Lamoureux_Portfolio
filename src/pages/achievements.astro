---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Empty from '../components/Empty.astro';
import Icon from '../components/Icon.astro';
import { getAchievements, formatMonth } from '../lib/utils';

const items = await getAchievements();
---

<BaseLayout title="Achievements" description="Awards, competitions, scholarships and certifications of Maxim Lamoureux.">
  <PageHeader title="Achievements" lead="Awards, competitions, scholarships and certifications." />

  <div class="container section-tight">
    {
      items.length === 0 ? (
        <Empty message="Nothing listed yet. Check back soon." />
      ) : (
        <ul class="achievement-list">
          {items.map(({ data }) => (
            <li class="card achievement">
              {data.image && (
                <Picture src={data.image} alt={data.imageAlt!} widths={[160, 320]} sizes="160px" formats={['avif', 'webp']} class="achievement-img" />
              )}
              <div>
                <p class="card-meta">
                  <span class="badge">{data.category}</span>
                  <time datetime={data.date.toISOString()}>{formatMonth(data.date)}</time>
                  {data.draft && <span class="draft-badge">Draft</span>}
                </p>
                <h2 class="card-title">{data.title}</h2>
                <p class="muted">{data.issuer}</p>
                {data.summary && <p>{data.summary}</p>}
                {data.url && (
                  <a class="link-arrow" href={data.url}>View <Icon name="external" size={15} /></a>
                )}
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>
