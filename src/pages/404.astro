  <PageHeader title="Page not found" lead="That page doesn't exist, or it moved.">
    <div class="button-row">
      <a class="btn btn-primary" href={url('/')}>Home</a>
      <a class="btn" href={url('/projects/')}>Projects</a>
    </div>
  </PageHeader>
</BaseLayout>
