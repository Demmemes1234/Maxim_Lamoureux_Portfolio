---
/**
 * Photo grid. Click (or Enter) on a photo to open it large in a lightbox;
 * arrow keys move between photos, Escape closes.
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  items: { src: ImageMetadata; alt: string; caption?: string }[];
}
const items = await Promise.all(
  Astro.props.items.map(async (item) => ({
    ...item,
    large: await getImage({ src: item.src, width: Math.min(item.src.width, 2000), format: 'webp' }),
  })),
);
---

{
  items.length > 0 && (
    <ul class="gallery" data-gallery>
      {items.map((item, i) => (
        <li>
          <figure>
            <a href={item.large.src} class="gallery-link" data-index={i} data-caption={item.caption ?? ''} data-alt={item.alt}>
              <Picture
                src={item.src}
                alt={item.alt}
                widths={[360, 640, 960]}
                sizes="(min-width: 900px) 33vw, (min-width: 560px) 50vw, 100vw"
                formats={['avif', 'webp']}
              />
              <span class="sr-only">(open larger)</span>
            </a>
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        </li>
      ))}
    </ul>
  )
}

<dialog class="lightbox" aria-label="Image viewer">
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <button type="button" class="lb-btn lb-close" aria-label="Close">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
  <button type="button" class="lb-btn lb-prev" aria-label="Previous image">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
  </button>
  <button type="button" class="lb-btn lb-next" aria-label="Next image">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
  </button>
  <p class="lb-count" aria-live="polite"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-gallery] .gallery-link')];
  if (dialog && links.length) {
    const img = dialog.querySelector('img')!;
    const cap = dialog.querySelector('figcaption')!;
    const count = dialog.querySelector('.lb-count')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + links.length) % links.length;
      const a = links[index];
      img.src = a.href;
      img.alt = a.dataset.alt ?? '';
      cap.textContent = a.dataset.caption ?? '';
      cap.hidden = !a.dataset.caption;
      count.textContent = links.length > 1 ? `${index + 1} / ${links.length}` : '';
    };
    prev.hidden = next.hidden = links.length < 2;

    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        opener = a;
        show(i);
        dialog.showModal();
      }),
    );
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    // Click on the dark backdrop closes it.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => opener?.focus());

    // Swipe on phones
    let x0: number | null = null;
    dialog.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>
